{
  "name": "mcp-contractlab",
  "version": "0.1.0-beta.1",
  "private": true,
  "description": "Deterministic MCP tool behavior contracts and conservative interface compatibility gates.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:smoke": "vitest run tests/integration",
    "demo": "node dist/examples/smoke-client.js",
    "cli": "node dist/src/cli.js",
    "prepack": "npm run build",
    "test:package": "node scripts/verify-package.mjs",
    "fixture:install": "npm ci --prefix tests/fixtures/independent --cache /tmp/mcpcl-independent-npm-cache",
    "test:independent": "vitest run --config vitest.independent.config.ts",
    "benchmark": "node scripts/benchmark.mjs",
    "test:browser": "node scripts/test-html-browser.mjs",
    "examples:html": "node scripts/generate-html-examples.mjs",
    "brand:export": "node scripts/export-brand.mjs",
    "docs:check": "node --test scripts/presentation.test.mjs && node scripts/check-presentation.mjs",
    "demo:breaking": "node scripts/generate-breaking-demo.mjs",
    "test:brand-browser": "node scripts/test-brand-browser.mjs",
    "release:notices": "node scripts/release/notices.mjs",
    "release:candidate": "npm run build && node scripts/release/candidate.mjs",
    "release:verify": "node scripts/release/consumer.mjs",
    "release:audit": "node scripts/release/audit.mjs",
    "test:consumer-browser": "node scripts/release/test-consumer-browser.mjs",
    "release:checks": "node --test scripts/release/release.test.mjs",
    "release:artifacts": "node scripts/release/check-artifacts.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "ajv": "8.20.0",
    "commander": "15.0.0",
    "ipaddr.js": "2.5.0",
    "undici": "7.30.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "fast-xml-parser": "5.11.2",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  },
  "bin": {
    "mcpcl": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "dist/examples",
    "examples/*.yaml",
    "docs",
    "AGENTS.md",
    "CONTRIBUTING.md",
    "CODEX_BUILD_PLAN.md",
    "assets/brand",
    "README.zh-CN.md",
    "THIRD_PARTY_NOTICES.md",
    "third-party-licenses"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dajinzhu/mcp-contractlab.git"
  },
  "bugs": {
    "url": "https://github.com/dajinzhu/mcp-contractlab/issues"
  },
  "homepage": "https://github.com/dajinzhu/mcp-contractlab#readme"
}
